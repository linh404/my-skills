meta {
  name: attach_files
  type: http
  seq: 47
}

post {
  url: {{base_url}}/api/models/hr-attendance-explanation/upload_files/attach_files
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  res_id: {{explanation_id}}
  files: @file(test-upload/placeholder.txt) @contentType(application/octet-stream)
}

script:post-response {
  const body = res.getBody();
  const ids = body?.data;
  if (!Array.isArray(ids) || !ids[0]) throw new Error("Explanation upload response did not contain attachment id");
  bru.setVar("explanation_attachment_id", String(ids[0]));
}
