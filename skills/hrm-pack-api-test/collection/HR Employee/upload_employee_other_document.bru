meta {
  name: upload_employee_other_document
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/models/hr-employee/upload_files/upload_employee_other_document
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  res_id: {{employee_id}}
  files: @file(test-upload/placeholder.txt) @contentType(application/octet-stream)
}

script:post-response {
  const body = res.getBody();
  const ids = body?.data;
  if (!Array.isArray(ids) || !ids[0]) throw new Error("employee_other_document upload response did not contain attachment id");
  bru.setVar("employee_employee_other_document_attachment_id", String(ids[0]));
}
