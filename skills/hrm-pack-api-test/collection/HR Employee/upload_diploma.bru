meta {
  name: upload_diploma
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/models/hr-employee/upload_files/upload_diploma
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  res_id: {{employee_id}}
  files: @file(test-upload/placeholder.txt) @contentType(application/octet-stream)
}

script:post-response {
  const body = res.getBody();
  const ids = body?.data;
  if (!Array.isArray(ids) || !ids[0]) throw new Error("diploma upload response did not contain attachment id");
  bru.setVar("employee_diploma_attachment_id", String(ids[0]));
}
