meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/json/2/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{user}}",
    "password": "{{password}}",
    "db": "{{db_name}}"
  }
}

script:post-response {
  const json = res.getBody();
  if (json && json.api_key) {
    bru.setEnvVar("token", json.api_key);
  }
}
